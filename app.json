{
  "expo": {
    "name": "inkwell",
    "slug": "inkwell",
    "version": "1.0.0",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "inkwell",
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-image"
    ],
    "android": {
      "package": "blog.micro.inkwell",
      "allowBackup": false
    },
    "ios": {
      "icon": {
        "light": "./assets/images/app-icon.png",
        "dark": "./assets/images/app-icon-dark.png"
      },
      "bundleIdentifier": "blog.micro.inkwell",
      "supportsTablet": true
    }
  }
}
